# For a shared production deployment, provision PostgreSQL and set these on the host.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-kamino-domain.example
VITE_AUTH_ENABLED=true
VITE_OAUTH_ENABLED=false
# npm run dev generates a local secret and stores data in .local-data automatically.
# Optional: override the local data directory via KAMINO_DATA_DIR.
# Start with an empty site (no built-in sample communities, members or posts). Recommended for a real public server.
# KAMINO_SAMPLE_CONTENT=off
# NITRO_PRESET=node-server by default; vercel is also supported.

# Voice, video and screen sharing behind strict networks (optional). Free public STUN servers are always used;
# add a TURN relay so calls also connect through office or mobile networks. Either a coturn server with a shared secret:
# KAMINO_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# KAMINO_TURN_SECRET=
# or one fixed login from a TURN service (Twilio, Metered, and similar):
# KAMINO_TURN_USERNAME=
# KAMINO_TURN_CREDENTIAL=
# Abuse limits (posting, commenting, messaging...) are on by default. Set to off only for load tests.
# KAMINO_RATE_LIMIT=off

# Files (photos, videos, voice notes, covers, quiz pictures) can live in an S3-compatible bucket instead of the database
# (Amazon S3, Cloudflare R2, Backblaze B2, MinIO...). Leave these empty to keep everything in the database.
# The bucket must be PRIVATE: Kamino checks who may see a file and hands it over itself.
# KAMINO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# KAMINO_S3_BUCKET=
# KAMINO_S3_ACCESS_KEY_ID=
# KAMINO_S3_SECRET_ACCESS_KEY=
# KAMINO_S3_REGION=auto
# Set to true only for a server that needs bucket-in-the-path addresses (MinIO and some others).
# KAMINO_S3_PATH_STYLE=false
